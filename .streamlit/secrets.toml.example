# Copia este archivo como .streamlit/secrets.toml (local) o pega su contenido en
# Streamlit Community Cloud → App settings → Secrets. NUNCA subas secrets.toml al repositorio.
#
# Contraseñas en SHA-256:
#   python -c "import hashlib; print(hashlib.sha256(b'tu-clave').hexdigest())"
# Roles disponibles: admin | cartera | direccion | analitica
# Si no defines [auth.users], el tablero arranca en modo demostración (sin contraseña).

[auth.users.admin]
name = "Administrador SAT"
role = "admin"
password_sha256 = "reemplaza-por-el-hash"

[auth.users.cartera]
name = "Equipo de Cartera"
role = "cartera"
password_sha256 = "reemplaza-por-el-hash"

[auth.users.direccion]
name = "Dirección Financiera"
role = "direccion"
password_sha256 = "reemplaza-por-el-hash"

[auth.users.analitica]
name = "Equipo de Analítica"
role = "analitica"
password_sha256 = "reemplaza-por-el-hash"

# API FastAPI del modelo (Despliegue/API.zip). Opcional: si no se define, el tablero
# usa el modelo local (requirements-model.txt) o acepta CSV ya puntuados.
[api]
url = "http://localhost:8001"
